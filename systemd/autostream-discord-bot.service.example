[Unit]
Description=discord-bot
After=network-online.target
Wants=network-online.target

[Service]
User=autostream
Group=autostream
# AUTOSTREAM_CONFIG_REVISION is read from this root-owned file and must be an integer >= 1.
EnvironmentFile=/etc/autostream/discord-bot.env
# Optional root-owned Control Panel managed bind/revision override. It is loaded
# after discord-bot.env so AUTOSTREAM_BIND_ADDR and AUTOSTREAM_CONFIG_REVISION win.
EnvironmentFile=-/opt/autostream/local-executor/ports/discord-bot.env
ExecStart=/usr/local/bin/autostream-discord-bot
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autostream/discord-bot
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
