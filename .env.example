AUTOSTREAM_NODE_CONFIG=/etc/autostream-discord-bot/config.yml
# Optional override for local/dev builds. Release and Docker builds embed this automatically.
# SERVICE_VERSION=dev
AUTOSTREAM_ENV=production
AUTOSTREAM_REQUIRE_CONTROL_PANEL_RUNTIME_CONFIG=true
# Root-owned locally applied service configuration revision reported to the updater.
AUTOSTREAM_CONFIG_REVISION=1

CONTROL_PANEL_HEARTBEAT_INTERVAL_SEC=30
# Panel-generated config.yml supplies SERVICE_ID, SERVICE_NAME,
# SERVICE_PUBLIC_URL, CONTROL_PANEL_URL, and CONTROL_PANEL_TOKEN.
#
# Compatibility fallback for older Control Panel dispatch. Prefer the
# Node Runtime Token from AUTOSTREAM_NODE_CONFIG for new Node Agent installs.
# SERVICE_CONTROL_TOKEN_SHA256=<SHA256_OF_CONTROL_PANEL_TO_SERVICE_TOKEN>

# Worker event URL and token are supplied per stream job by Control Panel.
DISCORD_WORKER_EVENT_TIMEOUT_SEC=3

ENCODER_AUDIO_TIMEOUT_SEC=5
ENCODER_AUDIO_RETRY_MAX=3
ENCODER_AUDIO_RETRY_BASE_DELAY_SEC=1
DISCORD_RECONNECT_ENABLED=true
DISCORD_RECONNECT_MAX_ATTEMPTS=5
DISCORD_RECONNECT_BASE_DELAY=2s
DISCORD_RECONNECT_MAX_DELAY=30s

# Standard host/systemd IPv4 loopback listen address. The port is configurable
# in the unprivileged range 1024-65535. If this key is absent, the binary keeps
# its legacy 127.0.0.1:8080 fallback for upgrade compatibility.
AUTOSTREAM_BIND_ADDR=127.0.0.1:8083
AUTOSTREAM_DISCORD_BOT_PORT=8083
AUTOSTREAM_DISCORD_BOT_CONTAINER_PORT=8080
TZ=Asia/Tokyo

# Normally managed by Control Panel Discord Bot Config.
# DISCORD_BOT_TOKEN=<DISCORD_BOT_TOKEN>

# Prefer stream-scoped ingest tokens from Control Panel. Static token is fallback only.
# ENCODER_AUDIO_TOKEN=<DISCORD_BOT_TO_ENCODER_AUDIO_TOKEN>
