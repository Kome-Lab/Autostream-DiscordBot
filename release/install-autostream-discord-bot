#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly SERVICE_NAME="discord-bot"
readonly ARTIFACT_PREFIX="autostream-discord-bot"
readonly MANIFEST_SERVICE="discord-bot"
readonly MANAGED_ROOT="/opt/autostream/discord-bot"
readonly RELEASES_DIR="${MANAGED_ROOT}/releases"
readonly CURRENT_LINK="${MANAGED_ROOT}/current"
readonly PUBLIC_BINARY="/usr/local/bin/autostream-discord-bot"
readonly PUBLIC_ALIAS="/usr/local/bin/discord-bot"
readonly ENV_DEST="/etc/autostream/discord-bot.env"
readonly UNIT_DEST="/etc/systemd/system/autostream-discord-bot.service"
readonly UNIT_NAME="autostream-discord-bot.service"
readonly STATE_DIR="/var/lib/autostream/discord-bot"
readonly BACKUP_BASE="/var/backups/autostream"
readonly BACKUP_ROOT="${BACKUP_BASE}/install-migrations"
readonly BACKUP_DIR="${BACKUP_ROOT}/discord-bot"

die() {
  printf 'install-autostream-discord-bot: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die "must run as root (use sudo)"
[[ $# -eq 0 ]] || die "this installer does not accept arguments"

for command in \
  awk basename chmod chown cmp cp dirname find flock getent grep groupadd id install jq \
  ln mktemp mv readlink rm runuser sha256sum stat sync systemctl tar uname useradd wc; do
  command -v "${command}" >/dev/null 2>&1 || die "required command is unavailable: ${command}"
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
[[ ${SCRIPT_DIR} == /* && -d ${SCRIPT_DIR} ]] || die "could not resolve the installer directory"
readonly SCRIPT_DIR
ARTIFACT_ID="$(basename -- "${SCRIPT_DIR}")"
[[ -n ${ARTIFACT_ID} ]] || die "could not resolve the artifact directory name"
readonly ARTIFACT_ID
if [[ ! ${ARTIFACT_ID} =~ ^autostream-discord-bot_(v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?)_linux_(amd64|arm64)$ ]]; then
  die "the extracted directory name is invalid: ${ARTIFACT_ID}"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[4]}"

case "$(uname -m)" in
  x86_64) readonly HOST_ARCH="amd64" ;;
  aarch64|arm64) readonly HOST_ARCH="arm64" ;;
  *) die "unsupported host architecture: $(uname -m)" ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || die "artifact architecture ${ARCH} does not match host ${HOST_ARCH}"

ARTIFACT_PARENT="$(dirname -- "${SCRIPT_DIR}")"
[[ ${ARTIFACT_PARENT} == /* && -d ${ARTIFACT_PARENT} ]] || die "could not resolve the artifact parent directory"
readonly ARTIFACT_PARENT
readonly ARCHIVE_NAME="${ARTIFACT_ID}.tar.gz"
readonly ARCHIVE_SOURCE="${ARTIFACT_PARENT}/${ARCHIVE_NAME}"
readonly ARCHIVE_CHECKSUM_SOURCE="${ARCHIVE_SOURCE}.sha256"
readonly MANIFEST_SOURCE="${ARTIFACT_PARENT}/release-manifest.json"
readonly MANIFEST_CHECKSUM_SOURCE="${ARTIFACT_PARENT}/release-manifest.json.sha256"

for source in \
  "${ARCHIVE_SOURCE}" \
  "${ARCHIVE_CHECKSUM_SOURCE}" \
  "${MANIFEST_SOURCE}" \
  "${MANIFEST_CHECKSUM_SOURCE}"; do
  [[ -f ${source} && ! -L ${source} ]] || die "required verified release file is missing or unsafe: ${source}"
done

INPUT_STAGE="$(mktemp -d /var/tmp/autostream-discord-bot-install.XXXXXXXX)"
[[ ${INPUT_STAGE} == /var/tmp/autostream-discord-bot-install.* &&
  -d ${INPUT_STAGE} && ! -L ${INPUT_STAGE} &&
  $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
  $(stat -c '%U:%G:%a' -- "${INPUT_STAGE}") == "root:root:700" ]] || \
  die "could not create a safe installer staging directory"
readonly INPUT_STAGE
readonly UNPACK_DIR="${INPUT_STAGE}/unpack"
managed_candidate=""
current_next=""
unit_stage=""
env_stage=""
public_link_next=""
activation_started=false
installation_complete=false
previous_current_kind="absent"
previous_current_target=""
declare -A previous_public_kind=()
declare -A previous_public_target=()
declare -A previous_public_mode=()
declare -A previous_public_sha256=()
unit_previous_kind="absent"
unit_previous_mode=""
unit_previous_sha256=""
unit_previous_backup="${INPUT_STAGE}/unit.previous"
unit_replaced=false
env_created=false
rollback_incomplete=false

restore_current_state() {
  local restore_next="${MANAGED_ROOT}/.current.rollback.$$"
  rm -f -- "${restore_next}" || return 1
  case "${previous_current_kind}" in
    absent)
      if [[ -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]]; then
        return 1
      fi
      rm -f -- "${CURRENT_LINK}" || return 1
      [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || return 1
      ;;
    symlink)
      if [[ -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]]; then
        return 1
      fi
      ln -s -- "${previous_current_target}" "${restore_next}" || return 1
      mv -Tf -- "${restore_next}" "${CURRENT_LINK}" || return 1
      [[ -L ${CURRENT_LINK} &&
        $(readlink -- "${CURRENT_LINK}") == "${previous_current_target}" ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f "${MANAGED_ROOT}" || return 1
}

restore_public_state() {
  local path=$1
  local kind="${previous_public_kind["${path}"]}"
  local restore_next="${path}.rollback.$$"
  local backup_path
  local backup_name
  rm -f -- "${restore_next}" || return 1
  if [[ -e ${path} && ! -L ${path} && ! -f ${path} ]]; then
    return 1
  fi
  case "${kind}" in
    absent)
      rm -f -- "${path}" || return 1
      [[ ! -e ${path} && ! -L ${path} ]] || return 1
      ;;
    symlink)
      ln -s -- "${previous_public_target["${path}"]}" "${restore_next}" || return 1
      mv -Tf -- "${restore_next}" "${path}" || return 1
      [[ -L ${path} &&
        $(readlink -- "${path}") == "${previous_public_target["${path}"]}" ]] || return 1
      ;;
    regular)
      backup_name="$(basename -- "${path}")" || return 1
      [[ -n ${backup_name} && ${backup_name} != */* ]] || return 1
      backup_path="${LEGACY_BACKUP_DIR}/${backup_name}"
      if [[ -f ${path} && ! -L ${path} &&
        $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == "${previous_public_sha256["${path}"]}" ]]; then
        chmod "${previous_public_mode["${path}"]}" "${path}" || return 1
      else
        [[ -f ${backup_path} && ! -L ${backup_path} ]] || return 1
        install -o root -g root -m "${previous_public_mode["${path}"]}" \
          "${backup_path}" "${restore_next}" || return 1
        [[ $(sha256sum -- "${restore_next}" | awk 'NR == 1 { print $1 }') == \
          "${previous_public_sha256["${path}"]}" ]] || return 1
        mv -Tf -- "${restore_next}" "${path}" || return 1
      fi
      [[ -f ${path} && ! -L ${path} &&
        $(stat -c '%U:%G:%a' -- "${path}") == "root:root:${previous_public_mode["${path}"]}" &&
        $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == \
          "${previous_public_sha256["${path}"]}" ]] || return 1
      sync -f "$(dirname -- "${path}")" || return 1
      rm -f -- "${backup_path}" || return 1
      sync -f "${LEGACY_BACKUP_DIR}" || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f "$(dirname -- "${path}")" || return 1
}

restore_unit_state() {
  local restore_next="/etc/systemd/system/.autostream-discord-bot.service.rollback.$$"
  [[ ${unit_replaced} == true ]] || return 0
  rm -f -- "${restore_next}" || return 1
  case "${unit_previous_kind}" in
    absent)
      [[ ! -L ${UNIT_DEST} ]] || return 1
      [[ ! -e ${UNIT_DEST} || -f ${UNIT_DEST} ]] || return 1
      rm -f -- "${UNIT_DEST}" || return 1
      [[ ! -e ${UNIT_DEST} && ! -L ${UNIT_DEST} ]] || return 1
      ;;
    regular)
      [[ -f ${unit_previous_backup} && ! -L ${unit_previous_backup} ]] || return 1
      install -o root -g root -m "${unit_previous_mode}" \
        "${unit_previous_backup}" "${restore_next}" || return 1
      [[ $(sha256sum -- "${restore_next}" | awk 'NR == 1 { print $1 }') == \
        "${unit_previous_sha256}" ]] || return 1
      mv -Tf -- "${restore_next}" "${UNIT_DEST}" || return 1
      [[ -f ${UNIT_DEST} && ! -L ${UNIT_DEST} &&
        $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == "root:root:${unit_previous_mode}" &&
        $(sha256sum -- "${UNIT_DEST}" | awk 'NR == 1 { print $1 }') == \
          "${unit_previous_sha256}" ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f /etc/systemd/system || return 1
}

rollback_activation() {
  local rollback_failed=false
  if ! restore_unit_state; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous systemd unit" >&2
    rollback_failed=true
  fi
  if [[ ${env_created} == true ]]; then
    if [[ -e ${ENV_DEST} || -L ${ENV_DEST} ]]; then
      if [[ -f ${ENV_DEST} && ! -L ${ENV_DEST} ]]; then
        rm -f -- "${ENV_DEST}" || rollback_failed=true
        if [[ -e ${ENV_DEST} || -L ${ENV_DEST} ]]; then
          rollback_failed=true
        fi
      else
        printf '%s\n' "install-autostream-discord-bot: refused to remove an unexpected environment path during rollback" >&2
        rollback_failed=true
      fi
    fi
    if ! sync -f "$(dirname -- "${ENV_DEST}")"; then
      rollback_failed=true
    fi
  fi
  if ! restore_public_state "${PUBLIC_BINARY}"; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous canonical public binary" >&2
    rollback_failed=true
  fi
  if ! restore_public_state "${PUBLIC_ALIAS}"; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous public alias" >&2
    rollback_failed=true
  fi
  if ! restore_current_state; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous current link" >&2
    rollback_failed=true
  fi
  if [[ ${unit_replaced} == true ]] && ! systemctl daemon-reload; then
    printf '%s\n' "install-autostream-discord-bot: failed to reload restored systemd state" >&2
    rollback_failed=true
  fi
  if [[ ${rollback_failed} == true ]]; then
    rollback_incomplete=true
    printf '%s\n' "install-autostream-discord-bot: rollback was incomplete; inspect the host before retrying" >&2
    return 1
  fi
  printf '%s\n' "install-autostream-discord-bot: restored the pre-install activation state" >&2
}

cleanup() {
  local status=$?
  trap - EXIT
  set +e
  if [[ ${status} -ne 0 && ${activation_started} == true && ${installation_complete} != true ]]; then
    rollback_activation
  fi
  if [[ -n ${managed_candidate} && -e ${managed_candidate} ]]; then
    rm -rf -- "${managed_candidate}"
  fi
  if [[ -n ${current_next} ]]; then
    rm -f -- "${current_next}"
  fi
  if [[ -n ${unit_stage} ]]; then
    rm -f -- "${unit_stage}"
  fi
  if [[ -n ${env_stage} ]]; then
    rm -f -- "${env_stage}"
  fi
  if [[ -n ${public_link_next} ]]; then
    rm -f -- "${public_link_next}"
  fi
  if [[ ${rollback_incomplete} == true ]]; then
    recovery_evidence_ready=true
    if ! {
      printf 'service=%s\n' "${SERVICE_NAME}"
      printf 'previous_current_kind=%s\n' "${previous_current_kind}"
      printf 'previous_current_target=%s\n' "${previous_current_target}"
      printf 'public_binary_kind=%s\n' "${previous_public_kind["${PUBLIC_BINARY}"]-unknown}"
      printf 'public_binary_target=%s\n' "${previous_public_target["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_mode=%s\n' "${previous_public_mode["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_sha256=%s\n' "${previous_public_sha256["${PUBLIC_BINARY}"]-}"
      printf 'public_alias_kind=%s\n' "${previous_public_kind["${PUBLIC_ALIAS}"]-unknown}"
      printf 'public_alias_target=%s\n' "${previous_public_target["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_mode=%s\n' "${previous_public_mode["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_sha256=%s\n' "${previous_public_sha256["${PUBLIC_ALIAS}"]-}"
      printf 'unit_previous_kind=%s\n' "${unit_previous_kind}"
      printf 'unit_previous_mode=%s\n' "${unit_previous_mode}"
      printf 'unit_previous_sha256=%s\n' "${unit_previous_sha256}"
    } > "${INPUT_STAGE}/recovery-state.txt"; then
      recovery_evidence_ready=false
    fi
    chown -R root:root "${INPUT_STAGE}" || recovery_evidence_ready=false
    chmod -R go-rwx "${INPUT_STAGE}" || recovery_evidence_ready=false
    if [[ -f ${unit_previous_backup} && ! -L ${unit_previous_backup} ]]; then
      sync -f "${unit_previous_backup}" || recovery_evidence_ready=false
    fi
    if [[ -f ${INPUT_STAGE}/recovery-state.txt && ! -L ${INPUT_STAGE}/recovery-state.txt ]]; then
      sync -f "${INPUT_STAGE}/recovery-state.txt" || recovery_evidence_ready=false
    else
      recovery_evidence_ready=false
    fi
    sync -f "${INPUT_STAGE}" || recovery_evidence_ready=false
    if [[ ${recovery_evidence_ready} == true ]]; then
      printf 'install-autostream-discord-bot: root-only recovery evidence preserved at %s\n' "${INPUT_STAGE}" >&2
    else
      printf 'install-autostream-discord-bot: WARNING: rollback was incomplete and recovery staging could not be fully sealed; inspect %s immediately\n' "${INPUT_STAGE}" >&2
    fi
  else
    rm -rf -- "${INPUT_STAGE}"
  fi
  exit "${status}"
}
trap cleanup EXIT
install -d -o root -g root -m 0700 "${UNPACK_DIR}"

copy_stable_source() {
  local source=$1
  local destination=$2
  local identity
  local digest
  identity="$(stat -c '%d:%i:%s:%Y:%f' -- "${source}")"
  digest="$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')"
  install -o root -g root -m 0600 "${source}" "${destination}"
  [[ -f ${source} && ! -L ${source} ]] || die "release source changed while being staged: ${source}"
  [[ $(stat -c '%d:%i:%s:%Y:%f' -- "${source}") == "${identity}" ]] || \
    die "release source identity changed while being staged: ${source}"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${digest}" ]] || \
    die "release source content changed while being staged: ${source}"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${digest}" ]] || \
    die "staged release file differs from its source: ${source}"
}

copy_stable_source "${ARCHIVE_SOURCE}" "${INPUT_STAGE}/${ARCHIVE_NAME}"
copy_stable_source "${ARCHIVE_CHECKSUM_SOURCE}" "${INPUT_STAGE}/${ARCHIVE_NAME}.sha256"
copy_stable_source "${MANIFEST_SOURCE}" "${INPUT_STAGE}/release-manifest.json"
copy_stable_source "${MANIFEST_CHECKSUM_SOURCE}" "${INPUT_STAGE}/release-manifest.json.sha256"

verify_checksum_file() {
  local checksum_path=$1
  local expected_name=$2
  local declared_name
  [[ $(wc -l < "${checksum_path}") -eq 1 ]] || die "checksum file must contain exactly one line: ${checksum_path}"
  grep -Eq '^[0-9a-f]{64}  [^/[:space:]]+$' "${checksum_path}" || \
    die "checksum file has an invalid format: ${checksum_path}"
  declared_name="$(awk 'NR == 1 { print $2 }' "${checksum_path}")"
  [[ ${declared_name} == "${expected_name}" ]] || \
    die "checksum file names ${declared_name}, expected ${expected_name}"
}

verify_checksum_file "${INPUT_STAGE}/${ARCHIVE_NAME}.sha256" "${ARCHIVE_NAME}"
verify_checksum_file "${INPUT_STAGE}/release-manifest.json.sha256" "release-manifest.json"
(cd -- "${INPUT_STAGE}" && sha256sum --check --strict "${ARCHIVE_NAME}.sha256")
(cd -- "${INPUT_STAGE}" && sha256sum --check --strict release-manifest.json.sha256)

ARTIFACT_SHA256="$(
  sha256sum -- "${INPUT_STAGE}/${ARCHIVE_NAME}" | awk 'NR == 1 { print $1 }'
)"
[[ ${ARTIFACT_SHA256} =~ ^[0-9a-f]{64}$ ]] || die "could not calculate the artifact SHA-256"
readonly ARTIFACT_SHA256
ARTIFACT_SIZE="$(stat -c %s -- "${INPUT_STAGE}/${ARCHIVE_NAME}")"
[[ ${ARTIFACT_SIZE} =~ ^[1-9][0-9]*$ ]] || die "could not calculate a positive artifact size"
readonly ARTIFACT_SIZE
jq -e \
  --arg version "${VERSION}" \
  --arg prefix "${ARTIFACT_PREFIX}" \
  --arg service "${MANIFEST_SERVICE}" \
  --arg arch "${ARCH}" \
  --arg name "${ARCHIVE_NAME}" \
  --arg sha256 "${ARTIFACT_SHA256}" \
  --argjson size "${ARTIFACT_SIZE}" \
  '((keys | sort) ==
     ["channel", "components", "minimum_agent_version", "published_at", "release_id", "schema_version"]) and
   (.schema_version == 1) and
   (.release_id == $version) and
   (.channel == "host") and
   (.published_at | type == "string" and
     test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
   (.minimum_agent_version | type == "string" and test("^v[0-9]+\\.[0-9]+\\.[0-9]+$")) and
   (.components | type == "array" and length == 1) and
   (.components[0] | type == "object") and
   ((.components[0] | keys | sort) ==
     ["artifacts", "commit", "database_schema", "rollback_compatible", "service", "source_version"]) and
   (.components[0].service == $service) and
   (.components[0].source_version == $version) and
   (.components[0].commit | type == "string" and test("^[0-9a-f]{40}$")) and
   (.components[0].rollback_compatible == true) and
   (.components[0].database_schema == "none") and
   (.components[0].artifacts | type == "array" and length == 2) and
   ([.components[0].artifacts[].arch] | sort == ["amd64", "arm64"]) and
   (all(.components[0].artifacts[];
     (type == "object") and
     ((keys | sort) == ["arch", "name", "os", "sha256", "size"]) and
     (.os == "linux") and
     (.arch == "amd64" or .arch == "arm64") and
     (.name == ($prefix + "_" + $version + "_linux_" + .arch + ".tar.gz")) and
     (.size | type == "number" and . > 0 and . <= 268435456) and
     (.sha256 | type == "string" and test("^[0-9a-f]{64}$")))) and
   ([.components[0].artifacts[] |
      select(.arch == $arch and
             .name == $name and
             .sha256 == $sha256 and
             .size == $size)] | length == 1)' \
  "${INPUT_STAGE}/release-manifest.json" >/dev/null || \
  die "release-manifest.json does not authorize this exact artifact"

tar -tzf "${INPUT_STAGE}/${ARCHIVE_NAME}" > "${INPUT_STAGE}/archive.list"
[[ -s ${INPUT_STAGE}/archive.list ]] || die "release archive is empty"
while IFS= read -r entry; do
  [[ ${entry} == "${ARTIFACT_ID}" || ${entry} == "${ARTIFACT_ID}/" || ${entry} == "${ARTIFACT_ID}/"* ]] || \
    die "release archive contains a path outside ${ARTIFACT_ID}: ${entry}"
  [[ ${entry} != /* &&
    ${entry} != ../* &&
    ${entry} != *"/../"* &&
    ${entry} != *"/.." &&
    ${entry} != *"/./"* &&
    ${entry} != *"/." &&
    ${entry} != *\\* ]] || die "release archive contains an unsafe path: ${entry}"
done < "${INPUT_STAGE}/archive.list"
while IFS= read -r entry; do
  case "${entry:0:1}" in
    -|d) ;;
    *) die "release archive contains a link or non-regular entry" ;;
  esac
done < <(tar -tvzf "${INPUT_STAGE}/${ARCHIVE_NAME}")

tar --no-same-owner --no-same-permissions \
  -xzf "${INPUT_STAGE}/${ARCHIVE_NAME}" \
  -C "${UNPACK_DIR}"
readonly EXTRACTED_ROOT="${UNPACK_DIR}/${ARTIFACT_ID}"
[[ -d ${EXTRACTED_ROOT} && ! -L ${EXTRACTED_ROOT} ]] || die "release archive root is missing or unsafe"
[[ -z $(find "${UNPACK_DIR}" -mindepth 1 -maxdepth 1 ! -name "${ARTIFACT_ID}" -print -quit) ]] || \
  die "release archive contains more than one top-level path"
[[ -z $(find "${EXTRACTED_ROOT}" -type l -print -quit) ]] || die "release archive must not contain symlinks"
[[ -z $(find "${EXTRACTED_ROOT}" ! -type d ! -type f -print -quit) ]] || \
  die "release archive must contain only directories and regular files"
[[ -f ${EXTRACTED_ROOT}/checksums.txt && ! -L ${EXTRACTED_ROOT}/checksums.txt ]] || \
  die "release checksums.txt is missing or unsafe"

declare -A CHECKSUM_PATHS=()
while IFS= read -r checksum_entry; do
  [[ ${checksum_entry} =~ ^[0-9a-f]{64}\ \ (.+)$ ]] || die "inner checksum entry has an invalid format"
  checked_path="${BASH_REMATCH[1]}"
  checked_path="${checked_path#./}"
  [[ -n ${checked_path} &&
    ${checked_path} != /* &&
    ${checked_path} != ../* &&
    ${checked_path} != *"/../"* &&
    ${checked_path} != *"/.." &&
    ${checked_path} != *"/./"* &&
    ${checked_path} != *"/." &&
    ${checked_path} != *\\* ]] || die "inner checksum entry has an unsafe path"
  [[ -z ${CHECKSUM_PATHS["${checked_path}"]+present} ]] || die "inner checksum path is duplicated: ${checked_path}"
  CHECKSUM_PATHS["${checked_path}"]=1
  [[ -f ${EXTRACTED_ROOT}/${checked_path} && ! -L ${EXTRACTED_ROOT}/${checked_path} ]] || \
    die "inner checksum entry does not name a regular file: ${checked_path}"
done < "${EXTRACTED_ROOT}/checksums.txt"
while IFS= read -r -d '' extracted_file; do
  relative_path="${extracted_file#"${EXTRACTED_ROOT}/"}"
  [[ ${relative_path} == "checksums.txt" || -n ${CHECKSUM_PATHS["${relative_path}"]+present} ]] || \
    die "release file is not listed in checksums.txt: ${relative_path}"
done < <(find "${EXTRACTED_ROOT}" -type f -print0)
(cd -- "${EXTRACTED_ROOT}" && sha256sum --check --strict checksums.txt)

for required in \
  "bin/autostream-discord-bot" \
  "bin/discord-bot" \
  ".env.example" \
  "systemd/autostream-discord-bot.service.example" \
  "install-autostream-discord-bot"; do
  [[ -f ${EXTRACTED_ROOT}/${required} && ! -L ${EXTRACTED_ROOT}/${required} ]] || \
    die "required release file is missing or unsafe: ${required}"
done
[[ -x ${EXTRACTED_ROOT}/bin/autostream-discord-bot ]] || die "Discord Bot binary is not executable"
[[ -x ${EXTRACTED_ROOT}/bin/discord-bot ]] || die "Discord Bot compatibility binary is not executable"
cmp -s \
  "${EXTRACTED_ROOT}/bin/autostream-discord-bot" \
  "${EXTRACTED_ROOT}/bin/discord-bot" || die "Discord Bot compatibility binary differs from the canonical binary"
version_output="$("${EXTRACTED_ROOT}/bin/autostream-discord-bot" --version)"
version_first_line="${version_output%%$'\n'*}"
[[ ${version_first_line} == "autostream-discord-bot ${VERSION}" ]] || \
  die "Discord Bot binary version does not exactly match ${VERSION}"

ensure_directory() {
  local path=$1
  local owner=$2
  local group=$3
  local mode=$4
  local existing_mode
  local existing_owner_group
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || die "required directory path is unsafe: ${path}"
    [[ $(readlink -f -- "${path}") == "${path}" ]] || die "required directory path is not canonical: ${path}"
    existing_owner_group="$(stat -c '%U:%G' -- "${path}")"
    [[ ${existing_owner_group} == "${owner}:${group}" ]] || \
      die "existing directory must be owned by ${owner}:${group}: ${path}"
    existing_mode="$(stat -c '%a' -- "${path}")"
    (( (8#${existing_mode} & 07022) == 0 )) || \
      die "existing directory has unsafe write or special mode bits: ${path}"
  fi
  install -d -o "${owner}" -g "${group}" -m "${mode}" "${path}"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || die "required directory path is not canonical: ${path}"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "${owner}:${group}:${mode#0}" ]] || \
    die "directory ownership or mode normalization failed: ${path}"
}

