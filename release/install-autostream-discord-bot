#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly SERVICE_NAME="discord-bot"
readonly MANAGED_ROOT="/opt/autostream/discord-bot"
readonly RELEASES_DIR="${MANAGED_ROOT}/releases"
readonly CURRENT_LINK="${MANAGED_ROOT}/current"
readonly PUBLIC_BINARY="/usr/local/bin/autostream-discord-bot"
readonly PUBLIC_ALIAS="/usr/local/bin/discord-bot"
readonly ENV_DEST="/etc/autostream/discord-bot.env"
readonly UNIT_DEST="/etc/systemd/system/autostream-discord-bot.service"
readonly UNIT_NAME="autostream-discord-bot.service"
readonly STATE_DIR="/var/lib/autostream/discord-bot"
readonly BACKUP_BASE="/var/backups/autostream"
readonly BACKUP_ROOT="${BACKUP_BASE}/install-migrations"
readonly BACKUP_DIR="${BACKUP_ROOT}/discord-bot"

die() {
  printf 'install-autostream-discord-bot: %s\n' "$*" >&2
  exit 1
}

cleanup_in_progress=false
signal_transaction_active=false
deferred_termination_status=0

handle_installer_signal() {
  local requested_status=$1
  if [[ ${signal_transaction_active} == true ]]; then
    deferred_termination_status=${requested_status}
    return 0
  fi
  exit "${requested_status}"
}

restore_installer_signal_traps() {
  if [[ ${cleanup_in_progress} == true ]]; then
    trap '' HUP INT TERM
    return
  fi
  trap 'handle_installer_signal 129' HUP
  trap 'handle_installer_signal 130' INT
  trap 'handle_installer_signal 143' TERM
}

begin_installer_signal_transaction() {
  [[ ${signal_transaction_active} == false ]] || \
    die "nested installer signal transaction is not allowed"
  signal_transaction_active=true
}

finish_installer_signal_transaction() {
  local requested_status
  signal_transaction_active=false
  requested_status=${deferred_termination_status}
  deferred_termination_status=0
  if (( requested_status != 0 )); then
    exit "${requested_status}"
  fi
}

[[ ${EUID} -eq 0 ]] || die "must run as root (use sudo)"
[[ $# -eq 0 ]] || die "this installer does not accept arguments"

for command in \
  awk basename chmod chown cmp cp dirname find flock getent grep groupadd groupdel id install jq \
  ln mktemp mv readlink rm rmdir runuser sha256sum sort stat sync systemctl tar uname uniq useradd userdel usermod wc; do
  command -v "${command}" >/dev/null 2>&1 || die "required command is unavailable: ${command}"
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
[[ ${SCRIPT_DIR} == /* && -d ${SCRIPT_DIR} ]] || die "could not resolve the installer directory"
readonly SCRIPT_DIR
ARTIFACT_ID="$(basename -- "${SCRIPT_DIR}")"
[[ -n ${ARTIFACT_ID} ]] || die "could not resolve the artifact directory name"
readonly ARTIFACT_ID
if [[ ! ${ARTIFACT_ID} =~ ^autostream-discord-bot_(v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?)_linux_(amd64|arm64)$ ]]; then
  die "the extracted directory name is invalid: ${ARTIFACT_ID}"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[4]}"

case "$(uname -m)" in
  x86_64) readonly HOST_ARCH="amd64" ;;
  aarch64|arm64) readonly HOST_ARCH="arm64" ;;
  *) die "unsupported host architecture: $(uname -m)" ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || die "artifact architecture ${ARCH} does not match host ${HOST_ARCH}"

ARTIFACT_PARENT="$(dirname -- "${SCRIPT_DIR}")"
[[ ${ARTIFACT_PARENT} == /* && -d ${ARTIFACT_PARENT} ]] || die "could not resolve the artifact parent directory"
readonly ARTIFACT_PARENT
readonly ARCHIVE_NAME="${ARTIFACT_ID}.tar.gz"
readonly ARCHIVE_SOURCE="${ARTIFACT_PARENT}/${ARCHIVE_NAME}"
readonly ARTIFACT_MANIFEST_NAME="artifact-manifest.json"
readonly MAX_ARCHIVE_SIZE=268435456
[[ -f ${ARCHIVE_SOURCE} && ! -L ${ARCHIVE_SOURCE} ]] || \
  die "required release archive is missing or unsafe: ${ARCHIVE_SOURCE}"
ARTIFACT_SIZE="$(stat -c %s -- "${ARCHIVE_SOURCE}")"
[[ ${ARTIFACT_SIZE} =~ ^[1-9][0-9]*$ &&
  ${ARTIFACT_SIZE} -le ${MAX_ARCHIVE_SIZE} ]] || \
  die "release archive size must be between 1 and ${MAX_ARCHIVE_SIZE} bytes"
readonly ARTIFACT_SIZE

INPUT_STAGE=""
INPUT_STAGE_IDENTITY=""

input_stage_is_owned() {
  [[ -n ${INPUT_STAGE} && -n ${INPUT_STAGE_IDENTITY} &&
    ${INPUT_STAGE} == /var/tmp/autostream-discord-bot-install.* &&
    -d ${INPUT_STAGE} && ! -L ${INPUT_STAGE} &&
    $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
    $(stat -c '%d:%i' -- "${INPUT_STAGE}") == "${INPUT_STAGE_IDENTITY}" ]]
}

cleanup_early_input_stage() {
  local status=$?
  trap '' HUP INT TERM
  trap - EXIT
  if [[ -z ${INPUT_STAGE} ]]; then
    :
  elif input_stage_is_owned; then
    rm -rf -- "${INPUT_STAGE}"
  else
    printf '%s\n' "install-autostream-discord-bot: refusing to remove replaced installer staging" >&2
    status=1
    fi
  exit "${status}"
}
trap cleanup_early_input_stage EXIT
restore_installer_signal_traps

# INPUT_STAGE is the single temporary-path journal exception: it is the
# root-only durable recovery container for every artifact kept after an
# incomplete rollback. Creation and identity capture are one deferred-signal
# transaction so a termination request cannot strand an unjournaled directory.
input_stage_failed=false
input_stage_failure_status=1
begin_installer_signal_transaction
if INPUT_STAGE="$(mktemp -d /var/tmp/autostream-discord-bot-install.XXXXXXXX)"; then
  :
else
  input_stage_failure_status=$?
  input_stage_failed=true
fi
if [[ ${input_stage_failed} == false &&
  ! ( ${INPUT_STAGE} == /var/tmp/autostream-discord-bot-install.* &&
  -d ${INPUT_STAGE} && ! -L ${INPUT_STAGE} &&
  $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
  $(stat -c '%U:%G:%a' -- "${INPUT_STAGE}") == "root:root:700" ) ]]; then
  input_stage_failed=true
fi
if [[ ${input_stage_failed} == false ]] &&
  ! INPUT_STAGE_IDENTITY="$(stat -c '%d:%i' -- "${INPUT_STAGE}")"; then
  input_stage_failed=true
fi
finish_installer_signal_transaction
if [[ ${input_stage_failed} == true ]]; then
  if [[ ${INPUT_STAGE} == /var/tmp/autostream-discord-bot-install.* &&
    -d ${INPUT_STAGE} && ! -L ${INPUT_STAGE} &&
    $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
    $(stat -c '%U' -- "${INPUT_STAGE}") == "root" ]]; then
    unsafe_input_stage_identity="$(stat -c '%d:%i' -- "${INPUT_STAGE}")"
    if [[ $(stat -c '%d:%i' -- "${INPUT_STAGE}") == "${unsafe_input_stage_identity}" ]]; then
      rm -rf -- "${INPUT_STAGE}"
    fi
  elif [[ -n ${INPUT_STAGE} ]]; then
    printf '%s\n' \
      "install-autostream-discord-bot: refusing to remove an unsafe installer staging path" >&2
  fi
  if [[ -z ${INPUT_STAGE} && ${input_stage_failure_status} -ne 1 ]]; then
    printf '%s\n' \
      "install-autostream-discord-bot: could not create the installer staging directory" >&2
    exit "${input_stage_failure_status}"
  fi
  die "could not create a safe installer staging directory"
fi
readonly INPUT_STAGE
readonly INPUT_STAGE_IDENTITY
readonly UNPACK_DIR="${INPUT_STAGE}/unpack"

managed_candidate=""
managed_candidate_identity=""
current_next=""
unit_stage=""
env_stage=""
public_link_next=""
activation_started=false
installation_complete=false
previous_current_kind="absent"
previous_current_target=""
declare -A previous_public_kind=()
declare -A previous_public_target=()
declare -A previous_public_mode=()
declare -A previous_public_sha256=()
declare -A previous_public_identity=()
declare -A previous_public_nlink=()
declare -A public_rollback_anchor=()
declare -A published_public_identity=()
declare -A published_public_target=()
unit_previous_kind="absent"
unit_previous_mode=""
unit_previous_sha256=""
unit_previous_backup="${INPUT_STAGE}/unit.previous"
unit_replaced=false
env_created=false
env_created_identity=""
state_dir_preexisting=false
state_dir_identity=""
state_dir_metadata=""
state_directory_mutation_started=false
state_directory_created_identity=""
created_autostream_user=false
created_autostream_user_record=""
created_autostream_group=false
created_autostream_group_record=""
preexisting_autostream_group_record=""
readonly AUTOSTREAM_USER_ROLLBACK_LOGIN="autostream-install-rollback"
autostream_user_rollback_login_ready=false
release_created=false
release_created_identity=""
rollback_incomplete=false
declare -a journaled_directory_order=()
declare -A journaled_directory_recorded=()
declare -A journaled_directory_previous_kind=()
declare -A journaled_directory_previous_identity=()
declare -A journaled_directory_previous_uid=()
declare -A journaled_directory_previous_gid=()
declare -A journaled_directory_previous_mode=()
declare -A journaled_directory_created_identity=()
declare -A temporary_path_identity=()
declare -A temporary_path_sync_parent=()
declare -A protected_temporary_path=()
declare -A backup_previous_kind=()
declare -A backup_previous_identity=()
declare -A backup_previous_uid=()
declare -A backup_previous_gid=()
declare -A backup_previous_mode=()
declare -A backup_previous_sha256=()
declare -A backup_created_identity=()

register_temporary_path() {
  local path=$1
  [[ -z ${temporary_path_identity["${path}"]+present} ]] || return 1
  temporary_path_identity["${path}"]="pending"
}

claim_temporary_path() {
  local path=$1
  local expected_identity="${2-}"
  local actual_identity
  [[ -n ${temporary_path_identity["${path}"]+present} &&
    ${temporary_path_identity["${path}"]} == "pending" &&
    ( -e ${path} || -L ${path} ) ]] || return 1
  actual_identity="$(stat -c '%d:%i' -- "${path}")" || return 1
  [[ -z ${expected_identity} || ${actual_identity} == "${expected_identity}" ]] || \
    return 1
  temporary_path_identity["${path}"]="${actual_identity}"
}

create_registered_temporary_path() {
  local output_variable=$1
  local path_kind=$2
  local template=$3
  local path=""
  local created_identity=""
  local transaction_failed=false

  # mktemp and journal claim form one deferred-signal ownership transaction.
  begin_installer_signal_transaction
  if [[ ${path_kind} == "directory" ]]; then
    if ! path="$(mktemp -d "${template}")"; then
      transaction_failed=true
    fi
  elif [[ ${path_kind} == "file" ]]; then
    if ! path="$(mktemp "${template}")"; then
      transaction_failed=true
    fi
  else
    transaction_failed=true
  fi
  if [[ ${transaction_failed} == false ]] &&
    ! register_temporary_path "${path}"; then
    transaction_failed=true
  fi
  if [[ ${transaction_failed} == false ]] &&
    ! created_identity="$(stat -c '%d:%i' -- "${path}")"; then
    transaction_failed=true
  fi
  if [[ ${transaction_failed} == false ]] &&
    ! claim_temporary_path "${path}" "${created_identity}"; then
    transaction_failed=true
  fi
  if [[ ${transaction_failed} == true ]]; then
    if [[ -n ${created_identity} && ( -e ${path} || -L ${path} ) &&
      $(stat -c '%d:%i' -- "${path}") == "${created_identity}" ]]; then
      if [[ ${path_kind} == "directory" ]]; then
        rm -rf -- "${path}"
      else
        rm -f -- "${path}"
      fi
    fi
    if [[ -n ${path} ]]; then
      forget_temporary_path "${path}"
    fi
  else
    printf -v "${output_variable}" '%s' "${path}"
  fi
  finish_installer_signal_transaction
  [[ ${transaction_failed} == false ]]
}

create_registered_symlink_path() {
  local target=$1
  local path=$2
  local transaction_failed=false

  # Registration, symlink creation, and inode claim are one deferred-signal journal
  # transaction. A path that races this claim remains pending and is never
  # removed without a proven invocation-owned identity.
  begin_installer_signal_transaction
  if ! register_temporary_path "${path}"; then
    transaction_failed=true
  fi
  if [[ ${transaction_failed} == false ]] &&
    ! ln -s -- "${target}" "${path}"; then
    if [[ ! -e ${path} && ! -L ${path} ]]; then
      forget_temporary_path "${path}"
    fi
    transaction_failed=true
  fi
  if [[ ${transaction_failed} == false ]] &&
    ! claim_temporary_path "${path}"; then
    transaction_failed=true
  fi
  finish_installer_signal_transaction
  [[ ${transaction_failed} == false ]]
}

forget_temporary_path() {
  local path=$1
  unset 'temporary_path_identity['"${path}"']'
  unset 'temporary_path_sync_parent['"${path}"']'
  unset 'protected_temporary_path['"${path}"']'
}

cleanup_temporary_paths() {
  local path
  local identity
  local sync_parent
  local cleanup_failed=false
  for path in "${!temporary_path_identity[@]}"; do
    identity="${temporary_path_identity["${path}"]}"
    sync_parent="${temporary_path_sync_parent["${path}"]-}"
    if [[ ${protected_temporary_path["${path}"]-false} == true ]]; then
      cleanup_failed=true
      continue
    fi
    if [[ ! -e ${path} && ! -L ${path} ]]; then
      unset 'temporary_path_identity['"${path}"']'
      unset 'temporary_path_sync_parent['"${path}"']'
      unset 'protected_temporary_path['"${path}"']'
      continue
    fi
    if [[ ${identity} == "pending" ||
      $(stat -c '%d:%i' -- "${path}") != "${identity}" ]]; then
      cleanup_failed=true
      continue
    fi
    rm -f -- "${path}" || cleanup_failed=true
    if [[ -e ${path} || -L ${path} ]]; then
      cleanup_failed=true
    else
      unset 'temporary_path_identity['"${path}"']'
      unset 'temporary_path_sync_parent['"${path}"']'
      unset 'protected_temporary_path['"${path}"']'
      if [[ -n ${sync_parent} ]] && ! sync -f "${sync_parent}"; then
        cleanup_failed=true
      fi
    fi
  done
  [[ ${cleanup_failed} == false ]]
}

journal_directory_before_mutation() {
  local path=$1
  local previous_kind="absent"
  local previous_identity=""
  local previous_uid=""
  local previous_gid=""
  local previous_mode=""
  [[ -z ${journaled_directory_recorded["${path}"]+present} ]] || return 0
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || return 1
    previous_kind="directory"
    previous_identity="$(stat -c '%d:%i' -- "${path}")" || return 1
    previous_uid="$(stat -c '%u' -- "${path}")" || return 1
    previous_gid="$(stat -c '%g' -- "${path}")" || return 1
    previous_mode="$(stat -c '%a' -- "${path}")" || return 1
  fi

  begin_installer_signal_transaction
  journaled_directory_recorded["${path}"]=true
  journaled_directory_order+=("${path}")
  journaled_directory_previous_kind["${path}"]="${previous_kind}"
  if [[ ${previous_kind} == "directory" ]]; then
    journaled_directory_previous_identity["${path}"]="${previous_identity}"
    journaled_directory_previous_uid["${path}"]="${previous_uid}"
    journaled_directory_previous_gid["${path}"]="${previous_gid}"
    journaled_directory_previous_mode["${path}"]="${previous_mode}"
  fi
  finish_installer_signal_transaction
}

record_journaled_directory_creation() {
  local path=$1
  local created_identity=""
  [[ ${signal_transaction_active} == true ]] || return 1
  if [[ ${journaled_directory_previous_kind["${path}"]} == "absent" ]]; then
    created_identity="$(stat -c '%d:%i' -- "${path}")" || return 1
    journaled_directory_created_identity["${path}"]="${created_identity}"
  fi
}

install_journaled_directory() {
  local path=$1
  local owner=$2
  local group=$3
  local mode=$4
  local created_identity_variable="${5-}"
  local transaction_failed=false

  begin_installer_signal_transaction
  if ! install -d -o "${owner}" -g "${group}" -m "${mode}" "${path}"; then
    transaction_failed=true
  elif ! record_journaled_directory_creation "${path}"; then
    transaction_failed=true
  elif [[ -n ${created_identity_variable} ]]; then
    printf -v "${created_identity_variable}" '%s' \
      "${journaled_directory_created_identity["${path}"]-}"
  fi
  finish_installer_signal_transaction
  [[ ${transaction_failed} == false ]]
}

rollback_journaled_directories() {
  local index
  local path
  local parent
  local rollback_failed=false
  for ((index=${#journaled_directory_order[@]} - 1; index >= 0; index--)); do
    path="${journaled_directory_order[index]}"
    case "${journaled_directory_previous_kind["${path}"]}" in
      directory)
        if [[ ! -d ${path} || -L ${path} ||
          $(stat -c '%d:%i' -- "${path}") != "${journaled_directory_previous_identity["${path}"]}" ]]; then
          rollback_failed=true
          continue
        fi
        chown "${journaled_directory_previous_uid["${path}"]}:${journaled_directory_previous_gid["${path}"]}" \
          "${path}" || rollback_failed=true
        chmod "${journaled_directory_previous_mode["${path}"]}" "${path}" || rollback_failed=true
        [[ $(stat -c '%d:%i:%u:%g:%a' -- "${path}") == \
          "${journaled_directory_previous_identity["${path}"]}:${journaled_directory_previous_uid["${path}"]}:${journaled_directory_previous_gid["${path}"]}:${journaled_directory_previous_mode["${path}"]}" ]] || \
          rollback_failed=true
        ;;
      absent)
        if [[ ! -e ${path} && ! -L ${path} ]]; then
          continue
        fi
        if [[ ! -d ${path} || -L ${path} ||
          -z ${journaled_directory_created_identity["${path}"]-} ||
          $(stat -c '%d:%i' -- "${path}") != "${journaled_directory_created_identity["${path}"]}" ||
          -n $(find "${path}" -mindepth 1 -print -quit) ]]; then
          rollback_failed=true
          continue
        fi
        rmdir -- "${path}" || rollback_failed=true
        parent="$(dirname -- "${path}")"
        sync -f "${parent}" || rollback_failed=true
        ;;
      *)
        rollback_failed=true
        ;;
    esac
  done
  [[ ${rollback_failed} == false ]]
}

rollback_created_release() {
  [[ ${release_created} == true ]] || return 0
  [[ -d ${RELEASE_DIR} && ! -L ${RELEASE_DIR} &&
    $(stat -c '%d:%i' -- "${RELEASE_DIR}") == "${release_created_identity}" &&
    $(dirname -- "${RELEASE_DIR}") == "${RELEASES_DIR}" ]] || return 1
  rm -rf -- "${RELEASE_DIR}" || return 1
  [[ ! -e ${RELEASE_DIR} && ! -L ${RELEASE_DIR} ]] || return 1
  sync -f "${RELEASES_DIR}" || return 1
  release_created=false
  release_created_identity=""
}

prepare_autostream_user_rollback_login() {
  if id autostream >/dev/null 2>&1; then
    return 0
  fi
  [[ -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  local_account_member_fields_are_clear || return 1
  autostream_user_rollback_login_ready=true
}

local_account_member_fields_are_clear() {
  [[ -f /etc/group && ! -L /etc/group &&
    -f /etc/gshadow && ! -L /etc/gshadow ]] || return 1
  awk -F: \
    -v service_login="autostream" \
    -v rollback_login="${AUTOSTREAM_USER_ROLLBACK_LOGIN}" \
    '{
      count = split($4, members, ",")
      for (member_index = 1; member_index <= count; member_index++) {
        if (members[member_index] == service_login || members[member_index] == rollback_login) {
          exit 1
        }
      }
    }' /etc/group || return 1
  awk -F: \
    -v service_login="autostream" \
    -v rollback_login="${AUTOSTREAM_USER_ROLLBACK_LOGIN}" \
    '{
      admin_count = split($3, admins, ",")
      for (admin_index = 1; admin_index <= admin_count; admin_index++) {
        if (admins[admin_index] == service_login || admins[admin_index] == rollback_login) {
          exit 1
        }
      }
      member_count = split($4, members, ",")
      for (member_index = 1; member_index <= member_count; member_index++) {
        if (members[member_index] == service_login || members[member_index] == rollback_login) {
          exit 1
        }
      }
    }' /etc/gshadow
}

local_account_database_matches_digests() {
  local expected_group_digest=$1
  local expected_gshadow_digest=$2
  local group_digest
  local gshadow_digest

  group_digest="$(sha256sum -- /etc/group | awk 'NR == 1 { print $1 }')" || return 1
  gshadow_digest="$(sha256sum -- /etc/gshadow | awk 'NR == 1 { print $1 }')" || return 1
  [[ ${group_digest} =~ ^[[:xdigit:]]{64}$ &&
    ${gshadow_digest} =~ ^[[:xdigit:]]{64}$ &&
    ${group_digest} == "${expected_group_digest}" &&
    ${gshadow_digest} == "${expected_gshadow_digest}" ]]
}

restore_created_autostream_user_login() {
  local expected_group_record=$1
  local renamed_user_record=$2
  local expected_group_digest=$3
  local expected_gshadow_digest=$4

  [[ -z $(getent passwd autostream 2>/dev/null || true) &&
    $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) == \
      "${renamed_user_record}" &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  usermod --login autostream "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" || return 1
  [[ $(getent passwd autostream 2>/dev/null || true) == \
      "${created_autostream_user_record}" &&
    -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  local_account_database_matches_digests \
    "${expected_group_digest}" \
    "${expected_gshadow_digest}" || return 1
  [[ $(getent group autostream 2>/dev/null || true) == "${expected_group_record}" ]]
}

remove_created_autostream_user_preserving_group() {
  local delete_status=0
  local expected_group_gid
  local expected_group_record
  local group_database_digest_before
  local gshadow_database_digest_before
  local rename_status=0
  local renamed_user_record
  local user_record_prefix
  local user_record_suffix

  [[ ${created_autostream_user} == true &&
    ${autostream_user_rollback_login_ready} == true &&
    ${created_autostream_user_record} =~ ^(autostream)(:[^:]*:[0-9]+:[1-9][0-9]*:[^:]*:/var/lib/autostream:/usr/sbin/nologin)$ ]] || \
    return 1
  user_record_prefix="${BASH_REMATCH[1]}"
  user_record_suffix="${BASH_REMATCH[2]}"
  [[ ${user_record_prefix} == "autostream" &&
    $(getent passwd autostream 2>/dev/null || true) == \
      "${created_autostream_user_record}" ]] || return 1

  if [[ ${created_autostream_group} == true ]]; then
    expected_group_record="${created_autostream_group_record}"
  else
    expected_group_record="${preexisting_autostream_group_record}"
  fi
  [[ -n ${expected_group_record} &&
    $(getent group autostream 2>/dev/null || true) == "${expected_group_record}" ]] || \
    return 1
  expected_group_gid="$(printf '%s\n' "${expected_group_record}" |
    awk -F: 'NR == 1 && $1 == "autostream" { print $3 }')"
  [[ ${expected_group_gid} =~ ^[1-9][0-9]*$ &&
    $(printf '%s\n' "${created_autostream_user_record}" |
      awk -F: 'NR == 1 { print $4 }') == "${expected_group_gid}" &&
    -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1

  group_database_digest_before="$(
    sha256sum -- /etc/group | awk 'NR == 1 { print $1 }'
  )" || return 1
  gshadow_database_digest_before="$(
    sha256sum -- /etc/gshadow | awk 'NR == 1 { print $1 }'
  )" || return 1
  [[ ${group_database_digest_before} =~ ^[[:xdigit:]]{64}$ &&
    ${gshadow_database_digest_before} =~ ^[[:xdigit:]]{64}$ ]] || return 1
  local_account_member_fields_are_clear || return 1
  local_account_database_matches_digests \
    "${group_database_digest_before}" \
    "${gshadow_database_digest_before}" || return 1

  # Ubuntu's USERGROUPS_ENAB makes userdel consider deleting a group whose name
  # matches the login being deleted. Rename only the invocation-created login
  # to a preflight-verified unused name; this keeps its primary GID and home
  # untouched while making the protected autostream group ineligible.
  renamed_user_record="${AUTOSTREAM_USER_ROLLBACK_LOGIN}${user_record_suffix}"
  if usermod --login "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" autostream; then
    :
  else
    rename_status=$?
  fi
  if [[ ${rename_status} -ne 0 ||
    -n $(getent passwd autostream 2>/dev/null || true) ||
    $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) != \
      "${renamed_user_record}" ||
    -n $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]]; then
    restore_created_autostream_user_login \
      "${expected_group_record}" \
      "${renamed_user_record}" \
      "${group_database_digest_before}" \
      "${gshadow_database_digest_before}" || true
    return 1
  fi
  if ! local_account_database_matches_digests \
    "${group_database_digest_before}" \
    "${gshadow_database_digest_before}"; then
    restore_created_autostream_user_login \
      "${expected_group_record}" \
      "${renamed_user_record}" \
      "${group_database_digest_before}" \
      "${gshadow_database_digest_before}" || true
    return 1
  fi

  if userdel "${AUTOSTREAM_USER_ROLLBACK_LOGIN}"; then
    delete_status=0
  else
    delete_status=$?
  fi
  if [[ ${delete_status} -ne 0 ]]; then
    restore_created_autostream_user_login \
      "${expected_group_record}" \
      "${renamed_user_record}" \
      "${group_database_digest_before}" \
      "${gshadow_database_digest_before}" || true
    return 1
  fi
  [[ -z $(getent passwd autostream 2>/dev/null || true) &&
    -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    $(getent group autostream 2>/dev/null || true) == "${expected_group_record}" &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  local_account_database_matches_digests \
    "${group_database_digest_before}" \
    "${gshadow_database_digest_before}" || return 1
  created_autostream_user=false
  created_autostream_user_record=""
}

rollback_created_autostream_account() {
  local current_group
  local rollback_failed=false
  if [[ ${created_autostream_user} == true ]]; then
    remove_created_autostream_user_preserving_group || rollback_failed=true
  fi
  if [[ ${created_autostream_group} == true &&
    ${created_autostream_user} == true ]]; then
    rollback_failed=true
  elif [[ ${created_autostream_group} == true ]]; then
    current_group="$(getent group autostream 2>/dev/null || true)"
    if [[ ${current_group} != "${created_autostream_group_record}" ]]; then
      rollback_failed=true
    elif ! groupdel autostream; then
      rollback_failed=true
    elif getent group autostream >/dev/null; then
      rollback_failed=true
    else
      created_autostream_group=false
      created_autostream_group_record=""
    fi
  fi
  [[ ${rollback_failed} == false ]]
}

restore_existing_state_directory() {
  local parent
  [[ ${state_directory_mutation_started} == true ]] || return 0
  if [[ ${state_dir_preexisting} == true ]]; then
    [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
      $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_dir_identity}" &&
      $(stat -c '%U:%G:%a' -- "${STATE_DIR}") == "${state_dir_metadata}" ]] || return 1
    return 0
  fi
  if [[ -e ${STATE_DIR} || -L ${STATE_DIR} ]]; then
    [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
      -n ${state_directory_created_identity} &&
      $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_directory_created_identity}" &&
      -z $(find "${STATE_DIR}" -mindepth 1 -print -quit) ]] || return 1
    rmdir -- "${STATE_DIR}" || return 1
  fi
  [[ ! -e ${STATE_DIR} && ! -L ${STATE_DIR} ]] || return 1
  parent="$(dirname -- "${STATE_DIR}")"
  sync -f "${parent}" || return 1
}

restore_current_state() {
  local restore_next="${MANAGED_ROOT}/.current.rollback.$$"
  [[ ! -e ${restore_next} && ! -L ${restore_next} ]] || return 1
  case "${previous_current_kind}" in
    absent)
      if [[ -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]]; then
        return 1
      fi
      rm -f -- "${CURRENT_LINK}" || return 1
      [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || return 1
      ;;
    symlink)
      if [[ -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]]; then
        return 1
      fi
      create_registered_symlink_path \
        "${previous_current_target}" \
        "${restore_next}" || return 1
      mv -Tf -- "${restore_next}" "${CURRENT_LINK}" || return 1
      forget_temporary_path "${restore_next}"
      [[ -L ${CURRENT_LINK} &&
        $(readlink -- "${CURRENT_LINK}") == "${previous_current_target}" ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f "${MANAGED_ROOT}" || return 1
}

restore_legacy_backup_state() {
  local path=$1
  local backup_name
  local backup_path
  backup_name="$(basename -- "${path}")" || return 1
  backup_path="${LEGACY_BACKUP_DIR}/${backup_name}"
  case "${backup_previous_kind["${path}"]-not-applicable}" in
    not-applicable)
      return 0
      ;;
    regular)
      [[ -f ${backup_path} && ! -L ${backup_path} &&
        $(stat -c '%d:%i' -- "${backup_path}") == "${backup_previous_identity["${path}"]}" &&
        $(stat -c '%u:%g:%a' -- "${backup_path}") == \
          "${backup_previous_uid["${path}"]}:${backup_previous_gid["${path}"]}:${backup_previous_mode["${path}"]}" &&
        $(sha256sum -- "${backup_path}" | awk 'NR == 1 { print $1 }') == \
          "${backup_previous_sha256["${path}"]}" ]] || return 1
      ;;
    absent)
      if [[ -z ${backup_created_identity["${path}"]-} ]]; then
        [[ ! -e ${backup_path} && ! -L ${backup_path} ]] || return 1
        return 0
      fi
      [[ -f ${backup_path} && ! -L ${backup_path} &&
        $(stat -c '%d:%i' -- "${backup_path}") == "${backup_created_identity["${path}"]}" ]] || return 1
      rm -f -- "${backup_path}" || return 1
      [[ ! -e ${backup_path} && ! -L ${backup_path} ]] || return 1
      sync -f "${LEGACY_BACKUP_DIR}" || return 1
      backup_created_identity["${path}"]=""
      ;;
    *)
      return 1
      ;;
  esac
}

observed_path_identity() {
  local path=$1
  if [[ -z ${path} || ( ! -e ${path} && ! -L ${path} ) ]]; then
    printf '%s' "absent"
  elif ! stat -c '%d:%i' -- "${path}"; then
    printf '%s' "unreadable"
  fi
}

observed_path_nlink() {
  local path=$1
  if [[ -z ${path} || ( ! -e ${path} && ! -L ${path} ) ]]; then
    printf '%s' "absent"
  elif ! stat -c '%h' -- "${path}"; then
    printf '%s' "unreadable"
  fi
}

remove_unchanged_public_rollback_anchor() {
  local path=$1
  local anchor="${public_rollback_anchor["${path}"]-}"
  local original_identity="${previous_public_identity["${path}"]-}"
  local original_nlink="${previous_public_nlink["${path}"]-}"
  local anchored_nlink
  local sync_parent
  [[ -n ${anchor} ]] || return 0
  [[ ${original_nlink} =~ ^[1-9][0-9]*$ ]] || return 1
  anchored_nlink=$((original_nlink + 1))
  sync_parent="$(dirname -- "${path}")" || return 1
  [[ ${protected_temporary_path["${anchor}"]-false} == true &&
    ${temporary_path_identity["${anchor}"]-pending} == "${original_identity}" &&
    -f ${anchor} && ! -L ${anchor} &&
    $(stat -c '%d:%i' -- "${anchor}") == "${original_identity}" &&
    $(stat -c '%h' -- "${anchor}") == "${anchored_nlink}" &&
    $(stat -c '%U:%G:%a' -- "${anchor}") == \
      "root:root:${previous_public_mode["${path}"]}" &&
    $(sha256sum -- "${anchor}" | awk 'NR == 1 { print $1 }') == \
      "${previous_public_sha256["${path}"]}" ]] || return 1
  rm -f -- "${anchor}" || return 1
  [[ ! -e ${anchor} && ! -L ${anchor} ]] || return 1
  sync -f "${sync_parent}" || return 1
  forget_temporary_path "${anchor}"
  unset 'public_rollback_anchor['"${path}"']'
}

completed_public_anchor_is_safe_to_remove() {
  local path=$1
  local anchor="${public_rollback_anchor["${path}"]-}"
  local original_identity="${previous_public_identity["${path}"]-}"
  local original_nlink="${previous_public_nlink["${path}"]-}"
  local published_identity="${published_public_identity["${path}"]-}"
  local published_target="${published_public_target["${path}"]-}"
  [[ ${previous_public_kind["${path}"]-unknown} == "regular" ]] || return 0
  [[ -n ${anchor} && -n ${original_identity} && -n ${published_identity} &&
    -n ${published_target} && ${original_nlink} =~ ^[1-9][0-9]*$ ]] || return 1
  [[ ${protected_temporary_path["${anchor}"]-false} == true &&
    ${temporary_path_identity["${anchor}"]-pending} == "${original_identity}" &&
    -f ${anchor} && ! -L ${anchor} &&
    $(stat -c '%d:%i' -- "${anchor}") == "${original_identity}" &&
    $(stat -c '%h' -- "${anchor}") == "${original_nlink}" &&
    $(stat -c '%U:%G:%a' -- "${anchor}") == \
      "root:root:${previous_public_mode["${path}"]}" &&
    $(sha256sum -- "${anchor}" | awk 'NR == 1 { print $1 }') == \
      "${previous_public_sha256["${path}"]}" &&
    -L ${path} && $(stat -c '%d:%i' -- "${path}") == "${published_identity}" &&
    $(readlink -- "${path}") == "${published_target}" ]]
}

release_completed_public_rollback_anchors() {
  local path
  local anchor
  local sync_parent
  for path in "${PUBLIC_BINARY}" "${PUBLIC_ALIAS}"; do
    completed_public_anchor_is_safe_to_remove "${path}" || return 1
  done
  for path in "${PUBLIC_BINARY}" "${PUBLIC_ALIAS}"; do
    if [[ ${previous_public_kind["${path}"]-unknown} == "regular" ]]; then
      completed_public_anchor_is_safe_to_remove "${path}" || return 1
      anchor="${public_rollback_anchor["${path}"]}"
      sync_parent="$(dirname -- "${anchor}")" || return 1
      rm -f -- "${anchor}" || return 1
      [[ ! -e ${anchor} && ! -L ${anchor} ]] || return 1
      sync -f "${sync_parent}" || return 1
      forget_temporary_path "${anchor}"
      unset 'public_rollback_anchor['"${path}"']'
    fi
  done
}

restore_public_state() {
  local path=$1
  local kind="${previous_public_kind["${path}"]}"
  local restore_next="${path}.rollback.$$"
  local anchor
  local original_identity="${previous_public_identity["${path}"]-}"
  local published_identity="${published_public_identity["${path}"]-}"
  local published_target="${published_public_target["${path}"]-}"
  local anchor_restored=false
  if [[ -e ${path} && ! -L ${path} && ! -f ${path} ]]; then
    return 1
  fi
  case "${kind}" in
    absent)
      if [[ -e ${path} || -L ${path} ]]; then
        [[ -n ${published_identity} && -n ${published_target} && -L ${path} &&
          $(stat -c '%d:%i' -- "${path}") == "${published_identity}" &&
          $(readlink -- "${path}") == "${published_target}" ]] || return 1
        rm -f -- "${path}" || return 1
      fi
      [[ ! -e ${path} && ! -L ${path} ]] || return 1
      ;;
    symlink)
      if [[ -L ${path} && -n ${original_identity} &&
        $(stat -c '%d:%i' -- "${path}") == "${original_identity}" &&
        $(readlink -- "${path}") == "${previous_public_target["${path}"]}" ]]; then
        :
      else
        [[ ! -e ${restore_next} && ! -L ${restore_next} ]] || return 1
        if [[ -e ${path} || -L ${path} ]]; then
          [[ -n ${published_identity} && -n ${published_target} && -L ${path} &&
            $(stat -c '%d:%i' -- "${path}") == "${published_identity}" &&
            $(readlink -- "${path}") == "${published_target}" ]] || return 1
        fi
        create_registered_symlink_path \
          "${previous_public_target["${path}"]}" \
          "${restore_next}" || return 1
        mv -Tf -- "${restore_next}" "${path}" || return 1
        forget_temporary_path "${restore_next}"
      fi
      [[ -L ${path} && -n ${original_identity} &&
        $(readlink -- "${path}") == "${previous_public_target["${path}"]}" ]] || return 1
      ;;
    regular)
      [[ -n ${original_identity} ]] || return 1
      if [[ -f ${path} && ! -L ${path} &&
        $(stat -c '%d:%i' -- "${path}") == "${original_identity}" ]]; then
        :
      else
        anchor="${public_rollback_anchor["${path}"]-}"
        [[ -n ${anchor} && -f ${anchor} && ! -L ${anchor} &&
          ${temporary_path_identity["${anchor}"]-pending} == "${original_identity}" &&
          $(stat -c '%d:%i' -- "${anchor}") == "${original_identity}" ]] || return 1
        # Once the public name no longer identifies the original inode, keep the
        # proven anchor out of generic temporary cleanup until it is moved back.
        # If any later ownership check refuses rollback, the original inode stays
        # available as root-only recovery evidence.
        if [[ -e ${path} || -L ${path} ]]; then
          [[ -n ${published_identity} && -n ${published_target} && -L ${path} &&
            $(stat -c '%d:%i' -- "${path}") == "${published_identity}" &&
            $(readlink -- "${path}") == "${published_target}" ]] || return 1
        fi
        [[ $(stat -c '%U:%G:%a' -- "${anchor}") == \
          "root:root:${previous_public_mode["${path}"]}" &&
          $(sha256sum -- "${anchor}" | awk 'NR == 1 { print $1 }') == \
            "${previous_public_sha256["${path}"]}" ]] || return 1
        mv -Tf -- "${anchor}" "${path}" || return 1
        anchor_restored=true
      fi
      if [[ ${anchor_restored} == false ]]; then
        remove_unchanged_public_rollback_anchor "${path}" || return 1
      fi
      [[ -f ${path} && ! -L ${path} &&
        $(stat -c '%d:%i' -- "${path}") == "${previous_public_identity["${path}"]}" &&
        $(stat -c '%h' -- "${path}") == "${previous_public_nlink["${path}"]}" &&
        $(stat -c '%U:%G:%a' -- "${path}") == "root:root:${previous_public_mode["${path}"]}" &&
        $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == \
          "${previous_public_sha256["${path}"]}" ]] || return 1
      sync -f "$(dirname -- "${path}")" || return 1
      if [[ ${anchor_restored} == true ]]; then
        forget_temporary_path "${anchor}"
        unset 'public_rollback_anchor['"${path}"']'
      fi
      # A backup is removed only after the public binary is proven restored.
      # On incomplete rollback it remains as a durable recovery backup.
      restore_legacy_backup_state "${path}" || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f "$(dirname -- "${path}")" || return 1
}

restore_unit_state() {
  local restore_next=""
  [[ ${unit_replaced} == true ]] || return 0
  case "${unit_previous_kind}" in
    absent)
      [[ ! -L ${UNIT_DEST} ]] || return 1
      [[ ! -e ${UNIT_DEST} || -f ${UNIT_DEST} ]] || return 1
      rm -f -- "${UNIT_DEST}" || return 1
      [[ ! -e ${UNIT_DEST} && ! -L ${UNIT_DEST} ]] || return 1
      ;;
    regular)
      [[ -f ${unit_previous_backup} && ! -L ${unit_previous_backup} ]] || return 1
      create_registered_temporary_path restore_next file \
        /etc/systemd/system/.autostream-discord-bot.service.rollback.XXXXXXXX || return 1
      install -o root -g root -m "${unit_previous_mode}" \
        "${unit_previous_backup}" "${restore_next}" || return 1
      [[ $(sha256sum -- "${restore_next}" | awk 'NR == 1 { print $1 }') == \
        "${unit_previous_sha256}" ]] || return 1
      mv -Tf -- "${restore_next}" "${UNIT_DEST}" || return 1
      forget_temporary_path "${restore_next}"
      [[ -f ${UNIT_DEST} && ! -L ${UNIT_DEST} &&
        $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == "root:root:${unit_previous_mode}" &&
        $(sha256sum -- "${UNIT_DEST}" | awk 'NR == 1 { print $1 }') == \
          "${unit_previous_sha256}" ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f /etc/systemd/system || return 1
}

rollback_activation() {
  local rollback_failed=false
  if ! restore_unit_state; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous systemd unit" >&2
    rollback_failed=true
  fi
  if [[ ${env_created} == true ]]; then
    if [[ -e ${ENV_DEST} || -L ${ENV_DEST} ]]; then
      if [[ -f ${ENV_DEST} && ! -L ${ENV_DEST} &&
        -n ${env_created_identity} &&
        $(stat -c '%d:%i' -- "${ENV_DEST}") == "${env_created_identity}" ]]; then
        rm -f -- "${ENV_DEST}" || rollback_failed=true
        if [[ -e ${ENV_DEST} || -L ${ENV_DEST} ]]; then
          rollback_failed=true
        fi
      else
        printf '%s\n' "install-autostream-discord-bot: refused to remove an unexpected environment path during rollback" >&2
        rollback_failed=true
      fi
    fi
    if ! sync -f "$(dirname -- "${ENV_DEST}")"; then
      rollback_failed=true
    fi
  fi
  if ! restore_public_state "${PUBLIC_BINARY}"; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous canonical public binary" >&2
    rollback_failed=true
  fi
  if ! restore_public_state "${PUBLIC_ALIAS}"; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous public alias" >&2
    rollback_failed=true
  fi
  if ! restore_current_state; then
    printf '%s\n' "install-autostream-discord-bot: failed to restore the previous current link" >&2
    rollback_failed=true
  fi
  if [[ ${unit_replaced} == true ]] && ! systemctl daemon-reload; then
    printf '%s\n' "install-autostream-discord-bot: failed to reload restored systemd state" >&2
    rollback_failed=true
  fi
  if [[ ${rollback_failed} == true ]]; then
    rollback_incomplete=true
    printf '%s\n' "install-autostream-discord-bot: rollback was incomplete; inspect the host before retrying" >&2
    return 1
  fi
  printf '%s\n' "install-autostream-discord-bot: restored the pre-install activation state" >&2
}

cleanup() {
  local status=$?
  local setup_rollback_safe=true
  trap '' HUP INT TERM
  cleanup_in_progress=true
  signal_transaction_active=false
  deferred_termination_status=0
  trap - EXIT
  set +e
  if [[ ${status} -ne 0 && ${activation_started} == true && ${installation_complete} != true ]]; then
    if ! rollback_activation; then
      setup_rollback_safe=false
    fi
  fi
  if [[ ${status} -ne 0 && ${installation_complete} != true &&
    ${state_directory_mutation_started} == true ]]; then
    if ! restore_existing_state_directory; then
      printf '%s\n' "install-autostream-discord-bot: failed to restore the previous state directory" >&2
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  if [[ -n ${managed_candidate} && ( -e ${managed_candidate} || -L ${managed_candidate} ) ]]; then
    if [[ -d ${managed_candidate} && ! -L ${managed_candidate} &&
      -n ${managed_candidate_identity} &&
      $(stat -c '%d:%i' -- "${managed_candidate}") == "${managed_candidate_identity}" ]]; then
      rm -rf -- "${managed_candidate}" || {
        rollback_incomplete=true
        setup_rollback_safe=false
      }
    else
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  managed_candidate=""
  managed_candidate_identity=""
  if [[ ${installation_complete} == true ]] &&
    ! release_completed_public_rollback_anchors; then
    printf '%s\n' "install-autostream-discord-bot: refused to remove an unproven public rollback anchor" >&2
    rollback_incomplete=true
    setup_rollback_safe=false
  fi
  if ! cleanup_temporary_paths; then
    printf '%s\n' "install-autostream-discord-bot: failed to clean an invocation-owned temporary path" >&2
    rollback_incomplete=true
    setup_rollback_safe=false
  fi
  if [[ ${status} -ne 0 && ${installation_complete} != true &&
    ${setup_rollback_safe} == true && ${release_created} == true ]]; then
    if ! rollback_created_release; then
      printf '%s\n' "install-autostream-discord-bot: failed to remove the invocation-created release" >&2
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  if [[ ${status} -ne 0 && ${installation_complete} != true ]]; then
    if ! rollback_journaled_directories; then
      printf '%s\n' "install-autostream-discord-bot: failed to restore invocation-mutated directories" >&2
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  if [[ ${status} -ne 0 && ${installation_complete} != true &&
    ${setup_rollback_safe} == true ]]; then
    if ! rollback_created_autostream_account; then
      printf '%s\n' "install-autostream-discord-bot: failed to remove the invocation-created service account" >&2
      rollback_incomplete=true
    fi
  fi
  if [[ ${rollback_incomplete} == true && ${status} -eq 0 ]]; then
    status=1
  fi
  if [[ ${rollback_incomplete} == true ]]; then
    recovery_evidence_ready=true
    if ! {
      printf 'service=%s\n' "${SERVICE_NAME}"
      printf 'previous_current_kind=%s\n' "${previous_current_kind}"
      printf 'previous_current_target=%s\n' "${previous_current_target}"
      printf 'public_binary_kind=%s\n' "${previous_public_kind["${PUBLIC_BINARY}"]-unknown}"
      printf 'public_binary_target=%s\n' "${previous_public_target["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_mode=%s\n' "${previous_public_mode["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_sha256=%s\n' "${previous_public_sha256["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_previous_identity=%s\n' "${previous_public_identity["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_previous_nlink=%s\n' "${previous_public_nlink["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_observed_identity=%s\n' "$(observed_path_identity "${PUBLIC_BINARY}")"
      printf 'public_binary_anchor_path=%s\n' "${public_rollback_anchor["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_anchor_expected_identity=%s\n' "${previous_public_identity["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_anchor_observed_identity=%s\n' \
        "$(observed_path_identity "${public_rollback_anchor["${PUBLIC_BINARY}"]-}")"
      printf 'public_binary_anchor_observed_nlink=%s\n' \
        "$(observed_path_nlink "${public_rollback_anchor["${PUBLIC_BINARY}"]-}")"
      printf 'public_binary_published_identity=%s\n' "${published_public_identity["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_published_target=%s\n' "${published_public_target["${PUBLIC_BINARY}"]-}"
      printf 'public_alias_kind=%s\n' "${previous_public_kind["${PUBLIC_ALIAS}"]-unknown}"
      printf 'public_alias_target=%s\n' "${previous_public_target["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_mode=%s\n' "${previous_public_mode["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_sha256=%s\n' "${previous_public_sha256["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_previous_identity=%s\n' "${previous_public_identity["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_previous_nlink=%s\n' "${previous_public_nlink["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_observed_identity=%s\n' "$(observed_path_identity "${PUBLIC_ALIAS}")"
      printf 'public_alias_anchor_path=%s\n' "${public_rollback_anchor["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_anchor_expected_identity=%s\n' "${previous_public_identity["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_anchor_observed_identity=%s\n' \
        "$(observed_path_identity "${public_rollback_anchor["${PUBLIC_ALIAS}"]-}")"
      printf 'public_alias_anchor_observed_nlink=%s\n' \
        "$(observed_path_nlink "${public_rollback_anchor["${PUBLIC_ALIAS}"]-}")"
      printf 'public_alias_published_identity=%s\n' "${published_public_identity["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_published_target=%s\n' "${published_public_target["${PUBLIC_ALIAS}"]-}"
      printf 'unit_previous_kind=%s\n' "${unit_previous_kind}"
      printf 'unit_previous_mode=%s\n' "${unit_previous_mode}"
      printf 'unit_previous_sha256=%s\n' "${unit_previous_sha256}"
    } > "${INPUT_STAGE}/recovery-state.txt"; then
      recovery_evidence_ready=false
    fi
    chown -R root:root "${INPUT_STAGE}" || recovery_evidence_ready=false
    chmod -R go-rwx "${INPUT_STAGE}" || recovery_evidence_ready=false
    if [[ -f ${unit_previous_backup} && ! -L ${unit_previous_backup} ]]; then
      sync -f "${unit_previous_backup}" || recovery_evidence_ready=false
    fi
    if [[ -f ${INPUT_STAGE}/recovery-state.txt && ! -L ${INPUT_STAGE}/recovery-state.txt ]]; then
      sync -f "${INPUT_STAGE}/recovery-state.txt" || recovery_evidence_ready=false
    else
      recovery_evidence_ready=false
    fi
    sync -f "${INPUT_STAGE}" || recovery_evidence_ready=false
    if [[ ${recovery_evidence_ready} == true ]]; then
      printf 'install-autostream-discord-bot: root-only recovery evidence preserved at %s\n' "${INPUT_STAGE}" >&2
    else
      printf 'install-autostream-discord-bot: WARNING: rollback was incomplete and recovery staging could not be fully sealed; inspect %s immediately\n' "${INPUT_STAGE}" >&2
    fi
  else
    if input_stage_is_owned; then
      rm -rf -- "${INPUT_STAGE}"
    else
      printf '%s\n' "install-autostream-discord-bot: refusing to remove replaced installer staging" >&2
      status=1
    fi
  fi
  exit "${status}"
}
