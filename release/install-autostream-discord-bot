        $(stat -c '%U:%G:%a' -- "${backup_path}") == "root:root:500" &&
        $(sha256sum -- "${backup_path}" | awk 'NR == 1 { print $1 }') == "${source_digest}" ]] || \
        die "legacy backup destination conflicts with ${link_path}"
